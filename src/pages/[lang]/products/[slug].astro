---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "../../../layouts/MainGridLayout.astro";
import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";

export async function getStaticPaths() {
	const products = await getCollection("products");

	return products.flatMap((product) => [
		{
			params: { lang: "en", slug: product.slug },
			props: { product },
		},
		{
			params: { lang: "vi", slug: product.slug },
			props: { product },
		},
	]);
}

const { product } = Astro.props;
const { Content } = await render(product);
const techStacks = Array.isArray(product.data.techStack)
	? product.data.techStack
	: typeof product.data.techStack === "string"
	? product.data.techStack.split(",").map((item) => item.trim()).filter(Boolean)
	: [];
const tags = Array.isArray(product.data.tags)
	? product.data.tags
	: typeof product.data.tags === "string"
	? product.data.tags.split(",").map((item) => item.trim()).filter(Boolean)
	: [];
const screenshots = product.data.screenshots ?? [];
const hasStoreLinks = Boolean(product.data.appStoreUrl || product.data.playStoreUrl);
---

<MainGridLayout title={product.data.title} description={product.data.description}>
	<article class:list={["w-full", hasStoreLinks && "pb-20 md:pb-0"]} data-pagefind-body>
		<!-- Hero -->
		<div class="card-base rounded-[var(--radius-large)] overflow-hidden mb-6">
			<div class="p-6 md:p-10 flex flex-col md:flex-row gap-6 md:gap-10 items-center md:items-start text-center md:text-left">
				{product.data.image && (
					<img
						src={product.data.image}
						alt={product.data.title}
						class="w-28 h-28 md:w-36 md:h-36 rounded-[2rem] shadow-lg shrink-0 object-cover"
					/>
				)}
				<div class="flex-1 min-w-0">
					<div class="flex flex-wrap justify-center md:justify-start gap-2 mb-3">
						{product.data.category && (
							<span class="text-xs bg-gray-200 dark:bg-gray-700 px-3 py-1 rounded-full">{product.data.category}</span>
						)}
						{product.data.status && (
							<span class="text-xs bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-200 px-3 py-1 rounded-full">{product.data.status}</span>
						)}
						{product.data.platform && (
							<span class="text-xs bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 px-3 py-1 rounded-full">{product.data.platform}</span>
						)}
					</div>
					<h1 class="text-3xl md:text-4xl font-bold mb-2">{product.data.title}</h1>
					{product.data.tagline && (
						<p class="text-lg opacity-80 mb-4">{product.data.tagline}</p>
					)}
					{hasStoreLinks && (
						<div class="flex flex-wrap justify-center md:justify-start gap-3 mt-4">
							{product.data.playStoreUrl && (
								<a
									href={product.data.playStoreUrl}
									target="_blank"
									rel="noreferrer"
									class="inline-flex items-center gap-2.5 rounded-xl bg-black text-white px-4 py-2.5 hover:opacity-85 transition-opacity dark:bg-white dark:text-black"
								>
									<Icon name="fa6-brands:google-play" class="text-[1.5rem]" />
									<span class="flex flex-col leading-tight items-start">
										<span class="text-[0.6rem] uppercase tracking-wide opacity-80">{i18n(I18nKey.freeDownload, Astro.currentLocale)}</span>
										<span class="text-sm font-semibold">{i18n(I18nKey.getOnGooglePlay, Astro.currentLocale)}</span>
									</span>
								</a>
							)}
							{product.data.appStoreUrl && (
								<a
									href={product.data.appStoreUrl}
									target="_blank"
									rel="noreferrer"
									class="inline-flex items-center gap-2.5 rounded-xl bg-black text-white px-4 py-2.5 hover:opacity-85 transition-opacity dark:bg-white dark:text-black"
								>
									<Icon name="fa6-brands:app-store-ios" class="text-[1.6rem]" />
									<span class="flex flex-col leading-tight items-start">
										<span class="text-[0.6rem] uppercase tracking-wide opacity-80">{i18n(I18nKey.freeDownload, Astro.currentLocale)}</span>
										<span class="text-sm font-semibold">{i18n(I18nKey.downloadOnAppStore, Astro.currentLocale)}</span>
									</span>
								</a>
							)}
						</div>
					)}
				</div>
			</div>
		</div>

		<!-- Screenshot gallery -->
		{screenshots.length > 0 && (
			<div class="card-base rounded-[var(--radius-large)] p-6 md:p-8 mb-6">
				<h2 class="text-sm uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 mb-4">
					{i18n(I18nKey.screenshots, Astro.currentLocale)}
				</h2>
				<div class="flex gap-4 overflow-x-auto pb-2 -mx-1 px-1 [scrollbar-width:thin]">
					{screenshots.map((src) => (
						<img
							src={src}
							alt={product.data.title}
							class="h-72 md:h-96 w-auto rounded-2xl shrink-0 shadow-md object-cover"
							loading="lazy"
						/>
					))}
				</div>
			</div>
		)}

		<div class="card-base rounded-[var(--radius-large)] p-6 md:p-9">
			<div class="grid gap-4 mb-8 pb-8 border-b md:grid-cols-2">
				{product.data.demo && (
					<div>
						<p class="text-sm uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 mb-2">Demo</p>
						<a href={product.data.demo} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-300 font-medium hover:text-blue-500 transition-colors">
							View demo
						</a>
					</div>
				)}
				{techStacks.length > 0 && (
					<div>
						<p class="text-sm uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 mb-3">Tech stack</p>
						<div class="flex flex-wrap gap-2">
							{techStacks.map((tech) => (
								<span class="text-xs bg-gray-100 dark:bg-gray-800 px-3 py-1 rounded-full">
									{tech}
								</span>
							))}
						</div>
					</div>
				)}
			</div>
			<Markdown>
				<Content />
			</Markdown>

			{hasStoreLinks && (
				<div class="mt-10 pt-8 border-t flex flex-wrap justify-center gap-3">
					{product.data.playStoreUrl && (
						<a
							href={product.data.playStoreUrl}
							target="_blank"
							rel="noreferrer"
							class="inline-flex items-center gap-2.5 rounded-xl bg-black text-white px-4 py-2.5 hover:opacity-85 transition-opacity dark:bg-white dark:text-black"
						>
							<Icon name="fa6-brands:google-play" class="text-[1.5rem]" />
							<span class="text-sm font-semibold">{i18n(I18nKey.getOnGooglePlay, Astro.currentLocale)}</span>
						</a>
					)}
					{product.data.appStoreUrl && (
						<a
							href={product.data.appStoreUrl}
							target="_blank"
							rel="noreferrer"
							class="inline-flex items-center gap-2.5 rounded-xl bg-black text-white px-4 py-2.5 hover:opacity-85 transition-opacity dark:bg-white dark:text-black"
						>
							<Icon name="fa6-brands:app-store-ios" class="text-[1.6rem]" />
							<span class="text-sm font-semibold">{i18n(I18nKey.downloadOnAppStore, Astro.currentLocale)}</span>
						</a>
					)}
				</div>
			)}

			{tags.length > 0 && (
				<div class="mt-8 pt-8 border-t">
					<div class="flex flex-wrap gap-2">
						{tags.map((tag) => (
							<span class="text-xs bg-gray-100 dark:bg-gray-800 px-3 py-1 rounded-full">
								{tag}
							</span>
						))}
					</div>
				</div>
			)}
		</div>
	</article>

	{hasStoreLinks && (
		<div class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-[var(--float-panel-bg)] shadow-[0_-4px_16px_rgba(0,0,0,0.12)] border-t border-black/5 dark:border-white/10 px-4 py-3 flex items-center gap-3">
			{product.data.image && (
				<img src={product.data.image} alt={product.data.title} class="w-10 h-10 rounded-xl shrink-0" />
			)}
			<span class="text-sm font-medium truncate flex-1">{product.data.title}</span>
			<div class="flex gap-2 shrink-0">
				{product.data.playStoreUrl && (
					<a href={product.data.playStoreUrl} target="_blank" rel="noreferrer" aria-label="Get it on Google Play" class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-black text-white dark:bg-white dark:text-black">
						<Icon name="fa6-brands:google-play" class="text-[1.1rem]" />
					</a>
				)}
				{product.data.appStoreUrl && (
					<a href={product.data.appStoreUrl} target="_blank" rel="noreferrer" aria-label="Download on the App Store" class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-black text-white dark:bg-white dark:text-black">
						<Icon name="fa6-brands:app-store-ios" class="text-[1.2rem]" />
					</a>
				)}
			</div>
		</div>
	)}
</MainGridLayout>
